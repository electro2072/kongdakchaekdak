# 알라딘 Open API 키 (https://www.aladin.co.kr/ttb/wblog_manage.aspx)
ALADIN_API_KEY=

# 카카오 도서 검색 API 키 (https://developers.kakao.com)
KAKAO_API_KEY=

# 카카오 로그인 네이티브 앱 키 (Kakao Developers > 내 애플리케이션 > 앱 키 > 네이티브 앱 키)
# 위 KAKAO_API_KEY(REST API 키, 책 검색용)와는 다른 키. 이 값은 android/ios 네이티브 파일
# (strings.xml/Info.plist/AndroidManifest.xml)에도 직접 입력해야 함 — 네이티브 URL 스킴은
# 빌드 타임에 고정돼야 해서 여기 값을 자동으로 읽어오지 못함.
KAKAO_NATIVE_APP_KEY=

# 구글 로그인 (Google Cloud Console > OAuth 클라이언트 ID)
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# 네이버 로그인 (네이버 개발자 센터 > 내 애플리케이션)
NAVER_CONSUMER_KEY=
NAVER_CONSUMER_SECRET=
NAVER_APP_NAME=콩닥책닥
NAVER_URL_SCHEME_IOS=
