<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--
        Railway 배포 환경은 컨테이너 파일시스템이 휘발성(ephemeral)이라 파일 로그를 남겨도
        재배포/재시작하면 사라진다. 그래서 콘솔(stdout) appender는 항상 켜두고, 파일 appender는
        로컬 개발(local 프로필)에서만 추가로 켠다.
    -->

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level traceId=%X{traceId} logType=%X{logType} %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <springProfile name="local">
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>logs/app.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>logs/app.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                <maxFileSize>50MB</maxFileSize>
                <maxHistory>14</maxHistory>
                <totalSizeCap>500MB</totalSizeCap>
            </rollingPolicy>
            <encoder>
                <pattern>${LOG_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
    </springProfile>

    <logger name="com.bookflex" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <springProfile name="local">
            <appender-ref ref="FILE"/>
        </springProfile>
    </root>

</configuration>
