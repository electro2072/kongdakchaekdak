# backend/.env — 이 파일을 복사해서 backend/.env 로 저장하고 실제 값을 채워넣으세요.
# backend/.env 자체는 절대 git에 커밋하지 않습니다 (루트 .gitignore의 ".env" 패턴에 이미 걸려있음).
# gradle bootRun 실행 시 build.gradle.kts가 이 파일을 자동으로 읽어 환경변수로 넘겨줍니다.

# 카카오 로그인 — 콘솔 등록 완료(2026-08-28). 앱 "독서 기록 어플 개발"(앱 ID 1502106, 개인 앱).
#   KAKAO_CLIENT_ID = REST API 키. 실제 값은 backend/.env 에만 넣을 것 (팀 공유 채널 참고).
#   프론트가 쓰는 네이티브 앱 키(strings.xml/Info.plist)와는 다른 키다.
#   KAKAO_CLIENT_SECRET = 현재 백엔드는 /v2/user/me 만 호출해서 미사용 — 비워둬도 됨.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 구글 로그인 — 콘솔 등록 완료. GCP 프로젝트 "kongdakchaekdak". 동의화면 프로덕션 게시됨(2026-08-29,
# 아무 구글 계정 로그인 가능). 브랜딩 인증만 보류(실도메인 생기면). 상세: docs/소셜로그인_설정현황.md
#   GOOGLE_CLIENT_ID = "웹 애플리케이션" 클라이언트 ID (Android/iOS 아님). 프론트 webClientId 와 같은 값.
#   실제 값은 backend/.env 에만 (팀 공유 채널 참고).
#   GOOGLE_CLIENT_SECRET = tokeninfo 방식이라 미사용 — 비워둬도 됨.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 네이버 로그인 — 콘솔 등록 완료(2026-08-29). 앱 "콩닥책닥", 환경=Android/iOS, 제공정보=별명.
#   백엔드는 /v1/nid/me 에 토큰만 보내서 아래 값 미사용이지만, 프론트 naver-login SDK 는
#   consumerKey(=CLIENT_ID) + consumerSecret(=CLIENT_SECRET) 둘 다 필요.
#   실제 값은 backend/.env 에만 (팀 공유 채널 참고).
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 책 사진(BookPhoto) 업로드용 S3 (AWS 콘솔 > S3 > 버킷 생성, IAM > 사용자 > 액세스 키 발급)
# IAM 사용자는 이 버킷에 대한 s3:PutObject 권한만 있으면 충분함 (presigned URL 발급용, 최소 권한 원칙).
AWS_S3_BUCKET=
AWS_S3_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_S3_PRESIGNED_URL_EXPIRATION_SECONDS=600

# 아래 두 개는 이미 Step 3에서 기본값이 있지만, 운영 배포 전에는 반드시 직접 값을 채워서 교체하세요.
# JWT_SECRET=
# JWT_EXPIRATION_SECONDS=3600
